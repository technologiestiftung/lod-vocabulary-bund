@prefix void: <http://rdfs.org/ns/void#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

lodvocab: a void:Dataset ;
    dcterms:created "2026-01-22"^^xsd:date ;
    dcterms:description "Verschiedene Vokabulare für Linked Open Data der deutschen Bundesverwaltung."@de,
        "Various vocabularies for linked open data from the German Federal Administration"@en ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:modified "2026-01-13"^^xsd:date ;
    dcterms:title "Deutsche LOD-Vokabulare auf Bundesebene"@de,
        "German Federal LOD Vocabularies"@en ;
    void:vocabulary bundorgs: ;
    foaf:homepage <https://github.com/technologiestiftung/lod-vocabulary-bund> ;
.
