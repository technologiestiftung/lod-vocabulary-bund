@prefix berorgs: <https://technologiestiftung.github.io/lod-vocabulary-bund/berorgs/> .
@prefix blnal: <https://technologiestiftung.github.io/lod-vocabulary-bund/blnal/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lodvocab: <https://technologiestiftung.github.io/lod-vocabulary-bund/> .
@prefix lorunits: <https://technologiestiftung.github.io/lod-vocabulary-bund/lorunits/> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix void: <http://rdfs.org/ns/void#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

lodvocab: a void:Dataset ;
    dcterms:created "2023-09-25"^^xsd:date ;
    dcterms:description "Verschiedene Vokabulare für Linked Open Data der Berliner Verwaltungen."@de,
        "Various vocabularies for linked open data published by the public administration of Berlin."@en ;
    dcterms:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dcterms:modified "2026-01-13"^^xsd:date ;
    dcterms:title "Berliner LOD-Vokabulare"@de,
        "Berlin LOD vocabularies"@en ;
    void:vocabulary berorgs: , blnal: , lorunits: ;
    blnal:changelog <https://github.com/technologiestiftung/lod-vocabulary-bund/blob/main/CHANGELOG.md> ;
    foaf:homepage <https://github.com/technologiestiftung/lod-vocabulary-bund> ;
.
